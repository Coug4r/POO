class Mundial:

    def __init__(self, nombre, sede, anio):
        self._nombre = nombre
        self._sede = sede
        self._anio = anio

        self.__equipos = []
        self.__partidos = []

    @property
    def nombre(self):
        return self._nombre

    @property
    def sede(self):
        return self._sede

    @property
    def anio(self):
        return self._anio

    @property
    def equipos(self):
        return self.__equipos

    @property
    def partidos(self):
        return self.__partidos

    def agregar_equipo(self, equipo):
        self.__equipos.append(equipo)

    def agregar_partido(self, partido):
        self.__partidos.append(partido)

    def buscar_equipo(self, nombre):
        for equipo in self.__equipos:
            if equipo.nombre.lower() == nombre.lower():
                return equipo
        return None

    def mostrar_mundial(self):
        print("\n========== MUNDIAL ==========")
        print("Nombre:", self.nombre)
        print("Sede:", self.sede)
        print("Año:", self.anio)

    def mostrar_equipos(self):
        for equipo in self.__equipos:
            equipo.mostrar_equipo()

    def mostrar_partidos(self):
        for partido in self.__partidos:
            partido.mostrar_partido()