class Persona:

    def __init__(self, nombre, edad, pais):
        self._nombre = nombre
        self._edad = edad
        self._pais = pais

    @property
    def nombre(self):
        return self._nombre

    @property
    def edad(self):
        return self._edad

    @property
    def pais(self):
        return self._pais

    def mostrar_info(self):
        print("Nombre:", self.nombre)
        print("Edad:", self.edad)
        print("País:", self.pais)